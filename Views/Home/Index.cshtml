@{
    ViewData["Title"] = "صفحه اصلی";
}

<!-- Hero / Masthead از تم -->
<header class="masthead">
    <div class="container position-relative">
        <div class="row justify-content-center">
            <div class="col-xl-6">
                <div class="text-center text-white">
                    <h1 class="mb-5">خیلی خوش اومدید!</h1>
                    <p class="lead mb-4">درود بر همه ی شما مشتریان عزیز و گرامی.</p>
                    <a class="btn btn-primary btn-lg" asp-controller="Friends" asp-action="List">مشاهده لیست دوستان</a>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Features ساده با کلاس‌های تم -->
<section class="features-icons bg-light text-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="features-icons-item mx-auto mb-5 mb-lg-0 mb-lg-3">
                    <div class="features-icons-icon d-flex">
                        <i class="bi-people m-auto text-primary"></i>
                    </div>
                    <h3>لیست دوستان</h3>
                    <p class="lead mb-0">دوستانت را ببین و مدیریت کن</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="features-icons-item mx-auto mb-5 mb-lg-0 mb-lg-3">
                    <div class="features-icons-icon d-flex">
                        <i class="bi-person-plus m-auto text-primary"></i>
                    </div>
                    <h3>افزودن دوست</h3>
                    <p class="lead mb-0">دوست جدید اضافه کن</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="features-icons-item mx-auto mb-0 mb-lg-3">
                    <div class="features-icons-icon d-flex">
                        <i class="bi-info-circle m-auto text-primary"></i>
                    </div>
                    <h3>قوانین</h3>
                    <p class="lead mb-0">قوانین سایت را مطالعه کنید</p>
                </div>
            </div>
        </div>
    </div>
</section>
